# Variables de entorno para conectar con Supabase.
#
# Para desarrollo local:
#   1) Copiar este archivo a `.env.local` (sin el .example al final)
#   2) Reemplazar los valores con los tuyos
#   3) Reiniciar `npm run dev`
#
# Para Vercel (producción):
#   1) Ir a https://vercel.com → tu proyecto → Settings → Environment Variables
#   2) Agregar las dos variables (Name + Value) marcando los 3 entornos:
#      Production, Preview, Development
#   3) Redeployar
#
# Los valores los encontrás en Supabase:
#   1) Tu proyecto → Settings → API
#   2) "Project URL" = NEXT_PUBLIC_SUPABASE_URL
#   3) "anon / public" key = NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# El prefijo NEXT_PUBLIC_ es obligatorio para que Next.js exponga las
# variables al cliente (el browser). Sin ese prefijo solo viven en el
# servidor y supabase-js no podría usarlas desde los stores.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Sentry (monitoreo de errores). OPCIONAL: si no lo seteás, Sentry queda
# apagado y la app funciona igual. El DSN lo sacás de tu proyecto en
# https://sentry.io -> Settings -> Projects -> (tu proyecto) -> Client Keys (DSN).
# Lleva NEXT_PUBLIC_ porque también inicializamos Sentry en el cliente.
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxx@oxxxxxx.ingest.sentry.io/xxxxxxx
